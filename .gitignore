node_modules
dist
# dist-template/index.html is COMMITTED, not ignored: the in-app updater
# fetches it from raw.githubusercontent.com at the release tag, which is the
# only route GitHub serves with CORS headers. Ignoring it breaks updating for
# every build that ships (DECISIONS.md D9). PowerPlanner.html is a byte-identical
# copy the release workflow makes from it, so only one of the two is tracked.
dist-template/PowerPlanner.html
.vite
*.log
.env
.env.local
.DS_Store
coverage
playwright-report
test-results
.tsbuildinfo
*.tsbuildinfo

# Local agent tooling (not project files)
mcps
terminals

# Native add-in build output
native/build
native/records/

# Python bytecode (native/tools harness driver)
__pycache__/
*.pyc

# Rasterized/recorded artifacts (regenerable from SVG / the app)
spec/visual/*.png

# overlay harness capture artifact (written to CWD by ppoverlay.exe)
overlay.png

# local Claude Code settings (per-machine MCP enablement)
.claude/settings.local.json
# PowerSpawn inter-agent context (auto-generated audit trail)
IAC.md

# Claude Code agent worktrees (local scratch, contains build artifacts)
.claude/worktrees/

# Agent bridge session token — regenerated on every bridge server start,
# never a repository secret (SRS-ABR-042)
.powerplanner-bridge.json
